# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js session encryption; generate a long random value and keep it private
AUTH_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET_ID=
CLIENT_SECRET_ID_GOOGLE=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Product-page analysis: maximum downloaded HTML bytes (default 5 MiB; hard-capped at 10 MiB)
SHOPES_PRODUCT_HTML_MAX_BYTES=5242880

# Database and background jobs (planned)
DATABASE_URL=
REDIS_URL=

# Optional SEO data provider (planned; never expose private keys in NEXT_PUBLIC_ variables)
SEO_DATA_PROVIDER=
SEO_DATA_API_KEY=

# Billing (planned)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
